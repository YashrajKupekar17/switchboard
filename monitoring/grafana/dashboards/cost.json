{
  "uid": "gateway-cost",
  "title": "Gateway: cost & usage",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Tokens per hour by deployment",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (deployment, kind) (increase(gateway_tokens_total[1h]))",
          "legendFormat": "{{deployment}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tokens in the selected time range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (deployment) (increase(gateway_tokens_total[$__range]))",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Budget used this month (1.0 = soft budget)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Spend / soft budget per team, as of each team's last request. Requests are refused at max_usd.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (team) (gateway_budget_used_ratio)",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Spend this month (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "From the gateway's running total. The Postgres usage_ledger table is the exact record.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (team) (gateway_budget_spent_usd)",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    }
  ]
}
