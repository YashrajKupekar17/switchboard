{
  "uid": "gateway-cost",
  "title": "Gateway: cost & usage",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Tokens per hour by deployment",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (deployment, kind) (increase(gateway_tokens_total[1h]))",
          "legendFormat": "{{deployment}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tokens in the selected time range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (deployment) (increase(gateway_tokens_total[$__range]))",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ]
    }
  ]
}